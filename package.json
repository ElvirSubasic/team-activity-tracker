{
  "name": "team-activity-tracker",
  "version": "0.1.6",
  "private": true,
  "author": "Elvir Subasic",
  "description": "Offline-first desktop scaffold with Electron + React + TypeScript + Vite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 tsx electron/main.ts",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "rebuild:native:electron": "npx electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "npm run rebuild:native:node && vitest run --passWithNoTests",
    "package": "npm run rebuild:native:electron && npm run build && electron-builder --publish never",
    "package:linux": "npm run rebuild:native:electron && npm run build && electron-builder --linux AppImage --publish never",
    "package:win": "npm run rebuild:native:electron && npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.elvirsubasic.teamactivitytracker",
    "artifactName": "team-activity-tracker-${version}-${os}-${arch}.${ext}",
    "executableName": "team-activity-tracker",
    "buildDependenciesFromSource": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "productName": "Team Activity Tracker",
    "linux": {
      "category": "Office",
      "icon": "build/icons/icon.png"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
